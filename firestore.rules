rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role in ['admin', 'instructor', 'assistant', 'inspector'] ||
        exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role in ['admin', 'instructor', 'assistant', 'inspector']
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Config & Settings
    match /artifacts/{appId}/public/config {
      allow read: if true;
      allow write: if isStaff();
    }
    
    // User Profiles
    match /artifacts/{appId}/public/data/users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Exams
    match /artifacts/{appId}/public/data/exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Grades
    match /artifacts/{appId}/public/data/grades/{gradeId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Attendance
    match /artifacts/{appId}/public/data/attendance/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Internal Staff Notes (student tracking portfolio)
    match /artifacts/{appId}/public/data/notes/{studentId} {
      allow read, write: if isStaff();
    }

    // Events & Meetings
    match /artifacts/{appId}/public/data/events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
  }
}
